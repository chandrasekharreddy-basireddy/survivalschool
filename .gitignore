# Node
node_modules/
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo

# Serwist/next-pwa service worker build output — regenerated on every
# `next build` (frontend/next.config.mjs's withSerwistInit), contains a
# per-build hashed asset manifest, not hand-maintained source. Source is
# frontend/src/app/sw.ts, which IS tracked.
frontend/public/sw.js
frontend/public/sw.js.map
frontend/public/swe-worker-*.js
frontend/public/swe-worker-*.js.map

# Local file uploads (default STORAGE_LOCAL_PATH; not for prod persistence)
backend/var/uploads/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Redis dump (created by local `redis-server` runs during dev/testing)
dump.rdb

# OS
.DS_Store

# Logs
*.log
npm-debug.log*

# Coverage
coverage/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
