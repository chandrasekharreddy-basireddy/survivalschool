# Copy to .env and fill in real values. Never commit the real .env file.

APP_ENV=development
APP_NAME=Survival School
DEBUG=true

DATABASE_URL=postgresql+asyncpg://survivalschool:survivalschool@postgres:5432/survivalschool
DATABASE_URL_SYNC=postgresql+psycopg2://survivalschool:survivalschool@postgres:5432/survivalschool

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-64-byte-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-64-byte-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:3000

# Only set to true if this app sits behind a reverse proxy (nginx-ingress, an
# ALB, Cloudflare, etc.) that you know sets/overwrites X-Forwarded-For itself.
# Leave false for local dev and for any deployment where the app is reachable
# directly — trusting this client-supplied header without a real proxy in
# front lets a caller spoof their IP for rate limiting and audit logs.
TRUST_PROXY_HEADERS=false

EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Survival School <no-reply@survivalschool.dev>
FRONTEND_URL=http://localhost:3000

AI_PROVIDER=mock
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-m
AI_DAILY_MESSAGE_LIMIT=100

N8N_WEBHOOK_BASE_URL=https://vishalreddy18.app.n8n.cloud
N8N_WEBHOOK_SECRET=change-me

POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/uploads

LOG_LEVEL=INFO
SERVICE_VERSION=0.1.0
