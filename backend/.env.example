# Copy to .env and fill in real values. Never commit the real .env file.

APP_ENV=development
APP_NAME=Survival School
DEBUG=true

DATABASE_URL=postgresql+asyncpg://survivalschool:survivalschool@postgres:5432/survivalschool
DATABASE_URL_SYNC=postgresql+psycopg2://survivalschool:survivalschool@postgres:5432/survivalschool

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-64-byte-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-64-byte-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:3000

# Only set to true if this app sits behind a reverse proxy (nginx-ingress, an
# ALB, Cloudflare, etc.) that you know sets/overwrites X-Forwarded-For itself.
# Leave false for local dev and for any deployment where the app is reachable
# directly — trusting this client-supplied header without a real proxy in
# front lets a caller spoof their IP for rate limiting and audit logs.
TRUST_PROXY_HEADERS=false

EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Survival School <no-reply@survivalschool.dev>
FRONTEND_URL=http://localhost:3000

AI_PROVIDER=mock
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-m
AI_DAILY_MESSAGE_LIMIT=100

N8N_WEBHOOK_BASE_URL=https://vishalreddy18.app.n8n.cloud
N8N_WEBHOOK_SECRET=change-me

# Optional. Real Power BI REST API push-dataset integration (service-
# principal / client-credentials OAuth2 flow). Leave all four unset to keep
# the integration inert (no-op, logged) — see app/services/powerbi_service.py
# and docs/POWERBI.md for the Azure AD app registration + workspace access
# setup steps. All four must be set together; a partially-configured set is
# treated as unconfigured (fails safe to inert, never a half-broken call).
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=

# local: writes to STORAGE_LOCAL_PATH on the app's own container disk. Fine
# for dev/CI, but Render's (and most PaaS) container filesystems are
# ephemeral -- wiped on every redeploy -- so this is NOT safe for real user
# uploads in production unless you've attached a real persistent disk.
# supabase: durable storage via Supabase Storage's REST API (real backend,
# see app/services/storage_service.py). Requires SUPABASE_STORAGE_URL and
# SUPABASE_SERVICE_ROLE_KEY below. Use this in production.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=var/uploads

# --- Supabase Storage (only used when STORAGE_BACKEND=supabase) ---
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_BUCKET=survivalschool-uploads
# Service role key (secret) -- Project Settings > API > service_role in the
# Supabase dashboard. Bypasses RLS; this app enforces its own auth/visibility
# checks in app/api/v1/files.py before ever calling storage, so that's fine.
SUPABASE_SERVICE_ROLE_KEY=

LOG_LEVEL=INFO
SERVICE_VERSION=1.0.0

# Optional. Leave blank to run without error tracking (the default — no
# fake DSN is provided anywhere in this repo). Set to a real Sentry DSN
# (https://<key>@<org>.ingest.sentry.io/<project>) to enable it; see
# docs/OBSERVABILITY.md.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Optional. Web Push (VAPID, RFC 8292) — no Firebase/APNs/OneSignal account
# needed. Generate a real, per-deployment keypair with
# `backend/scripts/generate_vapid_keys.py` and paste the output here (or set
# via real env vars in your host). Push sending silently no-ops when unset —
# see docs/PUSH_NOTIFICATIONS.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
