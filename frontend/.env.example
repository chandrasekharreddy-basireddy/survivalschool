NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Public site origin, used to build absolute URLs in sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL, read at BUILD time by next.config.mjs to allow-list
# the storage host for next/image. Only needed if uploaded images are served
# from a non-*.supabase.co host (self-hosted or custom-domain Supabase); the
# wildcard fallback covers standard hosted projects.
NEXT_PUBLIC_SUPABASE_URL=

# Optional. Leave blank to run without error tracking (the default — no
# fake DSN is provided anywhere in this repo). A Sentry DSN is not a
# secret (it's meant to be embedded in a public client bundle), so it's
# fine as a NEXT_PUBLIC_ var. See docs/OBSERVABILITY.md.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development

# Only needed in CI/build environments that actually upload source maps to
# a real Sentry project — safe to leave unset otherwise (next.config.mjs's
# withSentryConfig no-ops without it).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
