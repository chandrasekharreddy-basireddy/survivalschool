NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Optional. Leave blank to run without error tracking (the default — no
# fake DSN is provided anywhere in this repo). A Sentry DSN is not a
# secret (it's meant to be embedded in a public client bundle), so it's
# fine as a NEXT_PUBLIC_ var. See docs/OBSERVABILITY.md.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development

# Only needed in CI/build environments that actually upload source maps to
# a real Sentry project — safe to leave unset otherwise (next.config.mjs's
# withSentryConfig no-ops without it).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
