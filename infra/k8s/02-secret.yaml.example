# TEMPLATE ONLY — do not commit a real filled-in copy of this file.
#
# This is deliberately named *.yaml.example (not *.yaml) so `kubectl apply -f infra/k8s/`
# never picks it up by accident. Real values belong in your cluster's secret manager
# (Sealed Secrets, External Secrets Operator + a real vault, SOPS, etc.), never in git.
#
# Fill in, then apply out-of-band, e.g.:
#   kubectl create secret generic survivalschool-secrets -n survivalschool \
#     --from-literal=POSTGRES_PASSWORD=... \
#     --from-literal=JWT_SECRET=... \
#     --from-literal=SARVAM_API_KEY=... \
#     --from-literal=N8N_WEBHOOK_SECRET=... \
#     --from-literal=SMTP_USER=... \
#     --from-literal=SMTP_PASSWORD=... \
#     --from-literal=POWERBI_CLIENT_SECRET=...
apiVersion: v1
kind: Secret
metadata:
  name: survivalschool-secrets
  namespace: survivalschool
type: Opaque
stringData:
  POSTGRES_PASSWORD: "REPLACE_ME"
  # Fully rendered — must contain the SAME password as POSTGRES_PASSWORD above.
  # Kept here (not in the ConfigMap) because kubelet's $(VAR) expansion does not
  # apply to envFrom/configMapKeyRef values, so it cannot be composed at runtime
  # from separate ConfigMap + Secret parts without a wrapper entrypoint script.
  DATABASE_URL: "postgresql+asyncpg://survivalschool:REPLACE_ME@postgres:5432/survivalschool"
  DATABASE_URL_SYNC: "postgresql+psycopg2://survivalschool:REPLACE_ME@postgres:5432/survivalschool"
  JWT_SECRET: "REPLACE_ME_64_BYTE_RANDOM_STRING"
  SARVAM_API_KEY: "REPLACE_ME"
  N8N_WEBHOOK_SECRET: "REPLACE_ME"
  SMTP_USER: "REPLACE_ME"
  SMTP_PASSWORD: "REPLACE_ME"
  POWERBI_TENANT_ID: "REPLACE_ME"
  POWERBI_CLIENT_ID: "REPLACE_ME"
  POWERBI_CLIENT_SECRET: "REPLACE_ME"
  POWERBI_WORKSPACE_ID: "REPLACE_ME"
